{
  "name": "stream_receiver",
  "version": "1.0.0",
  "type": "module",
  "description": "Web Server for Redis camera streams",
  "main": "index.js",
  "scripts": {
    "test": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc",
    "build:client": "tsc -p src/client/tsconfig.json",
    "start": "node dist/server.js",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "docker:push": "docker buildx build --platform linux/amd64,linux/arm64 --target prod -t benten559/stream-receiver:latest --push ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Benten559/stream_receiver.git"
  },
  "author": "Benten559",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Benten559/stream_receiver/issues"
  },
  "homepage": "https://github.com/Benten559/stream_receiver#readme",
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "ioredis": "^5.9.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.9",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.1",
    "typescript": "^5.9.3"
  }
}
