# Use Debian Bookworm which has better Pi support
FROM python:3.11-slim-bookworm

WORKDIR /app

# Install system dependencies for camera access
RUN apt-get update && apt-get install -y \
    libgstreamer1.0-0 \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    libatlas-base-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies via pip
RUN pip install --no-cache-dir \
    redis==6.2.0 \
    numpy==1.24.3 \
    opencv-python-headless==4.8.1.78 \
    picamera2

# Copy camera client script
COPY cam_stream_client.py .

# Create log directory
RUN mkdir -p /tmp

# Create non-root user (but needs access to camera)
RUN useradd -m -u 1000 -G video appuser
USER appuser

# Run the camera client
CMD ["python", "cam_stream_client.py"]