# Multi-stage build for Raspberry Pi camera client
FROM python:3.11-slim-bullseye as builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    pkg-config \
    libopencv-dev \
    python3-opencv \
    && rm -rf /var/lib/apt/lists/*

# Runtime image
FROM python:3.11-slim-bullseye

WORKDIR /app

# Install runtime dependencies for Raspberry Pi camera
RUN apt-get update && apt-get install -y \
    python3-opencv \
    python3-picamera2 \
    libgstreamer1.0-0 \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    libatlas-base-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies directly
RUN pip install --no-cache-dir \
    redis==6.2.0 \
    opencv-python-headless==4.8.1.78 \
    numpy==1.24.3

# Copy camera client script
COPY cam_stream_client.py .

# Create log directory
RUN mkdir -p /tmp

# Create non-root user (but needs access to camera)
RUN useradd -m -u 1000 -G video appuser
USER appuser

# Run the camera client
CMD ["python", "cam_stream_client.py"]